	show[w]

	show[l[][0]]
	show[l[10][5]]
	show[l[false][0][20]]

	F-3
	F-4

let f[x | $i, y | [$i, $i] -> [$s]]
	show[y[x, x]]

let f[x | $i, y | $i] | $s
	return "{ x } + { y } = { x + y}"

let f[x | $$T]
	show[x[1, 2]]

let g[x | $i, y | $i] | $s
	return "{ x } - { y } = { x - y }"

let h[x | $i] | [$i, $i] -> [$s]
	if x == 0
		return &f
	else
		return &g

let i[x | $i] | $s
	return ''

let i[x | $f] | [$s, $i] -> [$s]
	show['f']
	return &k

let j[x | [] -> [$fd]] | {$s}
	show['g']
	return {''}

let k | $fd
	show['h_']
	return 0.0d

let k[x | $s, y | $i] | $s
	show['h_$s']
	return "{ x } = { y }"

let l | [$i] -> [$b]
	return &m

let l[x | $i] | $s
	show[x]
	return 'Hello, World!'

let l[x | $b] | {[$i]->[$b]}
	return {&m}

let m[x | $i] | $b
