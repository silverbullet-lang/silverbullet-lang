use	f as F-3 from file3
use f as F-4 from file4

let start
	f[1, &g]
	f[&g]

	x := 0
	y := h[x]
	show[y[x, x + 1]]
	y = h[x + 2]
	show[y[x + 3, x + 4]]

	z := G-1[x]
	show[z[100.0, 300.0]]
	z = G-1[1]
	show[z[200.0, 400.0]]

	G-2[&F-1, 5.0, 5.0]
	G-2[&F-2, 25.0, 5.0]

